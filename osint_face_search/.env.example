# ==========================================================
# OSINT Face Search - Environment Configuration
# Bu dosyayı .env olarak kopyalayın ve değerleri doldurun
# ==========================================================

# Uygulama
APP_NAME=osint-face-search
APP_ENV=development
LOG_LEVEL=INFO

# API
API_V1_PREFIX=/api/v1
API_KEY=change-me-in-production-please

# PostgreSQL
POSTGRES_USER=osint
POSTGRES_PASSWORD=osint_dev_password
POSTGRES_DB=osint_face_search
POSTGRES_HOST=localhost
POSTGRES_PORT=5432
DATABASE_URL=postgresql+psycopg2://osint:osint_dev_password@localhost:5432/osint_face_search

# Qdrant
QDRANT_HOST=localhost
QDRANT_PORT=6333
QDRANT_COLLECTION=face_embeddings
QDRANT_VECTOR_SIZE=512

# Yüz tanıma
FACE_MODEL_NAME=buffalo_l
FACE_DETECTION_THRESHOLD=0.6
FACE_MATCH_THRESHOLD=0.55
MAX_IMAGE_SIZE_MB=10

# KVKK / Saklama
EMBEDDING_RETENTION_DAYS=90
AUDIT_LOG_RETENTION_DAYS=730

# ==========================================================
# DIŞ SERVİS ADAPTÖR API ANAHTARLARI
# Hangileri tanımlıysa o adaptör otomatik etkin olur.
# Boş bırakırsanız ilgili adaptör devre dışı kalır.
# ==========================================================

# Tier 1 - Belgelenmiş resmi API'ler

# FaceCheck.ID — yüz arama, ABD merkezli
# Kayıt: https://facecheck.id/Face-Search/API
FACECHECK_API_KEY=

# TinEye — reverse image search (yüze özel değil), Kanada
# Kayıt: https://services.tineye.com/TinEyeAPI
TINEYE_API_KEY=

# Bing Visual Search — Microsoft Azure
# Kayıt: Azure Portal → Cognitive Services → Bing Visual Search v7
BING_API_KEY=

# Google Cloud Vision — web detection + face detection
# Kayıt: console.cloud.google.com → Vision API
GOOGLE_VISION_API_KEY=

# SauceNAO — sanat/anime reverse image (ücretsiz tier mevcut)
# Kayıt opsiyonel: https://saucenao.com/user.php?page=search-api
SAUCENAO_API_KEY=

# FaceSeek — meta-aggregator (FaceCheck/Lenso/PimEyes'i birleştirir)
# Kayıt: https://faceseek.online
FACESEEK_API_KEY=


# Tier 2 - Ticari/Kurumsal (özel anlaşma gerekir)

# PimEyes — yüz arama, AB merkezli
# Kayıt: PimEyes Pro/PROtect — kurumsal satış üzerinden
PIMEYES_API_KEY=

# Lenso.ai — yüz + logo + manzara, AB merkezli
LENSO_API_KEY=


# Orkestratör
ORCHESTRATOR_TIMEOUT_SECONDS=120
# Varsayılan adaptör listesi (boş bırakırsanız tüm etkinler kullanılır)
ORCHESTRATOR_DEFAULT_ADAPTERS=facecheck,tineye,saucenao
